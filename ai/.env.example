# MediQueue AI Service — ortam değişkenleri
# Bu dosyayı kopyalayıp .env olarak kaydedin: cp .env.example .env

# Uygulama adı (Swagger başlığında görünür)
APP_NAME=MediQueue AI Service

# API versiyonu (Swagger ve / endpoint'inde görünür)
APP_VERSION=1.0.0

# Sunucunun dinleyeceği host (0.0.0.0 = tüm arayüzler)
HOST=0.0.0.0

# Sunucu portu (varsayılan: 8001)
PORT=8001

# Geliştirme modu — true ise uvicorn --reload ve DEBUG log seviyesi
DEBUG=false

# CORS izin verilen origin'ler (virgülle ayrılmış; allow_credentials=True ile wildcard kullanılamaz)
# Değer verilmezse varsayılan: http://localhost:3000, http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Eşleştirme skorunun başlangıç değeri (0–100 arası hesaplamanın tabanı)
BASE_SCORE=60.0
# Hasta şehri ile doktor şehri eşleşirse eklenen bonus puan
CITY_MATCH_BONUS=15.0
# Doktor rating'inden türetilen maksimum bonus puan
MAX_RATING_BONUS=15.0
# Doktor deneyim yılından türetilen maksimum bonus puan
MAX_EXPERIENCE_BONUS=10.0
# Rating normalizasyonunda kullanılan üst sınır (ör. 5 üzerinden)
MAX_RATING=5.0
# Deneyim bonusu hesabında kullanılan maksimum yıl sınırı
MAX_EXPERIENCE_YEARS=20

# PostgreSQL bağlantısı (backend ile aynı veritabanı ve doctors tablosu)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mediqueue
