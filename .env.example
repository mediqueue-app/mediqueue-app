# Copy to .env in the repo root before `docker compose up`.
# Do not commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mediqueue
POSTGRES_PORT=5432

API_PORT=8000
AI_PORT=8001
CLINIC_PORT=3000
DOCTOR_PORT=3001
PATIENT_PORT=3002
ADMIN_PORT=3003
MARKETING_PORT=3004

APP_ENV=development
SECRET_KEY=UNSAFE-LOCAL-DEV-ONLY-do-not-use-in-production
# Local dummy Fernet key (32 zero bytes). Generate a real one for staging/production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mediqueue
MEDIQUEUE_AI_BASE_URL=http://ai:8001
SEED_ON_START=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_GA_ID=
LEADS_WEBHOOK_URL=

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004
AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004
