PROJECT_NAME=MediQueue API
API_V1_PREFIX=/v1
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mediqueue
SECRET_KEY=replace-this-with-a-long-random-secret
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MEDIQUEUE_AI_BASE_URL=http://localhost:8001
MEDIQUEUE_AI_TIMEOUT_SECONDS=5
# Comma-separated. For staging, set portal origins explicitly. Do not use *.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://localhost:5173,http://localhost:8080
